---
import { destacados } from '../../data/proyectos'; import './Proyectos.css';
---
<section class="seccion" id="proyectos" aria-labelledby="titulo-proyectos"><div class="contenedor"><p class="etiqueta">Repositorios públicos</p><div class="proyectos__cabecera"><div><h2 class="titulo-seccion" id="titulo-proyectos">Trabajo visible, contexto real.</h2><p class="intro">Los repositorios se consultan desde GitHub cuando hay conexión. Esta selección editorial conserva contexto aun si la API no responde.</p></div><a class="boton" href="https://github.com/ladardrgz" target="_blank" rel="noopener noreferrer">Perfil de GitHub ↗</a></div><div class="carrusel" data-carrusel tabindex="0" aria-label="Proyectos públicos"><div class="carrusel__pista" data-pista>{destacados.map((proyecto)=><article class="proyecto" data-proyecto={proyecto.repositorio}><p>{proyecto.tipo}</p><h3>{proyecto.nombre}</h3><p class="proyecto__descripcion">{proyecto.descripcion}</p><footer><span data-lenguaje>{proyecto.lenguaje}</span><a href={`https://github.com/ladardrgz/${proyecto.repositorio}`} target="_blank" rel="noopener noreferrer">Código ↗</a></footer></article>)}</div></div><div class="carrusel__controles"><button type="button" data-anterior aria-label="Proyecto anterior">←</button><p data-estado aria-live="polite">Selección inicial disponible.</p><button type="button" data-siguiente aria-label="Proyecto siguiente">→</button></div></div></section><script src="./carrusel.ts"></script>
