---
import { siAstro, siCss, siFigma, siGit, siGithub, siHtml5, siJavascript, siMysql, siPhp, siTypescript } from 'simple-icons';
const iconos = { html:siHtml5, css:siCss, javascript:siJavascript, typescript:siTypescript, astro:siAstro, php:siPhp, mysql:siMysql, git:siGit, github:siGithub, figma:siFigma };
const { nombre, color = 'currentColor' } = Astro.props as { nombre:keyof typeof iconos | 'database'; color?:string };
const icono = nombre === 'database' ? null : iconos[nombre];
---
{icono ? <svg viewBox="0 0 24 24" role="img" aria-label={icono.title} fill={color}><path d={icono.path}/></svg> : <svg viewBox="0 0 24 24" role="img" aria-label="Base de datos" fill="none" stroke={color} stroke-width="1.7"><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v7c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 12v7c0 1.7 3.1 3 7 3s7-1.3 7-3v-7"/></svg>}
